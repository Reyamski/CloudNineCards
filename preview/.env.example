# Cloud Nine Cards — environment variables
# Copy to .env (gitignored) and fill in real values.
#
# Vite rules:
#   - Vars with VITE_ prefix are inlined into the client JS bundle (browser-visible).
#   - Vars WITHOUT VITE_ prefix are server-only (Vercel functions in preview/api/).
# Never put secrets behind a VITE_ prefix.

# ── EmailJS (client-side; non-secret keys) ────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_PRIVATE_KEY=
VITE_EMAILJS_TEMPLATE_ONHAND=
VITE_EMAILJS_TEMPLATE_PREORDER=

# ── imgbb (client-side image upload) ──────────────────────────────────────────
VITE_IMGBB_API_KEY=

# ── Admin auth (SERVER-ONLY — do not prefix with VITE_) ───────────────────────
# ADMIN_PASSWORD     : the password admins type at /admin
# ADMIN_SESSION_SECRET: HMAC secret used to sign 24h session tokens
# The previous VITE_ADMIN_PASSWORD is DEPRECATED — it leaked into the client
# bundle. Remove it from your environment after deploying this change.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Contact ───────────────────────────────────────────────────────────────────
VITE_CONTACT_EMAIL=

# ── Supabase (anon key is browser-safe by design) ─────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Shopify (server-side credentials) ─────────────────────────────────────────
SHOPIFY_STORE=
SHOPIFY_EMAIL=
SHOPIFY_PASSWORD=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Anthropic (server-side — used by /api/analyze-card) ───────────────────────
ANTHROPIC_API_KEY=

# ── eBay Finding API (server-side — used by /api/fetch-prices) ────────────────
EBAY_APP_ID=
